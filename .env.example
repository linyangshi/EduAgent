# 复制为 .env 并填写本机配置。用 set -a，. ./.env，set +a 将变量载入当前 shell。
# 生成随机 SECRET_KEY：python -c 'import secrets; print(secrets.token_hex(32))'
# 请将生成值保存在本机 .env 中；所有服务进程应使用同一个值。
SECRET_KEY=''
DASHSCOPE_API_KEY=''

# 可选模型服务，仅填写准备使用的服务。代理地址须与该服务签发的密钥配套。
# KIMI_API_KEY=''
# FIREWORKS_API_KEY=''
# GROQ_API_KEY=''
# SILICON_API_KEY=''
# SHENMA_API_KEY=''
# OPENAI_PROXY_BASE=''

# 邮件验证码
# MAIL_SERVER=''
# MAIL_PORT=465
# MAIL_USE_SSL=true
# MAIL_USE_TLS=false
# MAIL_USERNAME=''
# MAIL_PASSWORD=''
# MAIL_DEFAULT_SENDER=''

# 登录回调 URL 需要与对应服务商登记的地址一致。
# WECHAT_APP_ID=''
# WECHAT_APP_SECRET=''
# WECHAT_CALLBACK_URL=''
# QQ_APP_ID=''
# QQ_APP_SECRET=''
# QQ_CALLBACK_URL=''

# 可选。需要初始化管理员时填写以下三项。
# EDUAGENT_ADMIN_USERNAME=''
# EDUAGENT_ADMIN_EMAIL=''
# EDUAGENT_ADMIN_PASSWORD=''
